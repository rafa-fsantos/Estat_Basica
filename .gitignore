# ==============================================================================
# Ambientes Virtuais (Python, Conda/Mamba & R)
# ==============================================================================
.venv/
venv/
ENV/
env/
.env

# Conda / Mamba (ambientes criados com prefixo local, ex: conda create -p ./env)
.conda/
conda-meta/
.mamba/

# R & RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# ==============================================================================
# Byte-code e Caches do Python
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ==============================================================================
# Jupyter Notebooks & Caches
# ==============================================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*-checkpoint.ipynb

# ==============================================================================
# Dados e Artefatos Locais
# ==============================================================================
# Ignora arquivos de dados grandes ou brutos (descomente se preferir baixar sob demanda)
# data/raw/*
# !data/raw/.gitkeep
# data/processed/*
# !data/processed/.gitkeep

# Arquivos temporários e saídas de gráficos/relatórios
*.log
*.tmp
*.temp
reports/figures/*
!reports/figures/.gitkeep

# ==============================================================================
# IDEs e Editores de Código
# ==============================================================================
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# ==============================================================================
# Sistema Operacional
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
